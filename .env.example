# ---- Database (PostgreSQL / Neon) ----------------------------------------
# Both are injected automatically by Vercel's Neon integration; locally copy
# them from Vercel -> Storage -> Neon -> Quickstart. The pooled host contains
# "-pooler"; the unpooled (direct) host is the same without it. Migrations run
# over DATABASE_URL_UNPOOLED (directUrl in schema.prisma); runtime queries use
# the pooled DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ---- Auth.js (NextAuth v5) ------------------------------------------------
AUTH_SECRET="replace-with-output-of: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
GOOGLE_ID=""
GOOGLE_SECRET=""

# ---- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ---- Email (SMTP) ---------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Store <no-reply@example.com>"

# ---- Uploads: "local" (dev) | "s3" ---------------------------------------
UPLOAD_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
