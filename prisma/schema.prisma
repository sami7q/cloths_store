// Prisma schema — full data model per STORE-BUILD-PROMPT.md §4.
//
// Datasource: PostgreSQL (Neon via Vercel's native integration).
//   - DATABASE_URL          → pooled connection (PgBouncer, "-pooler" host) — runtime queries.
//   - DATABASE_URL_UNPOOLED → direct connection — used by `prisma migrate` via directUrl.
// Both are injected automatically by the Neon integration on Vercel; locally
// copy them from Vercel → Storage → Neon → Quickstart into .env.
//
// Native enums mirror src/lib/enums.ts (names/values identical) — enums.ts
// remains the app-side source of truth for Zod/forms/server actions.
// Money columns are @db.Decimal(10, 2); long-form text is @db.Text.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// Enums — keep in lockstep with src/lib/enums.ts
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PaymentMethod {
  CARD
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum CouponScope {
  ALL
  CATEGORY
  PRODUCT
}

enum PromoType {
  BUY_X_GET_DISCOUNT
  BUNDLE_PRICE
  CARD_EXTRA_PERCENT
  FREE_SHIPPING_OVER
}

enum BannerPlacement {
  HERO
  LIFESTYLE
  SIDE_TAB
  MARQUEE
  SOCIAL_GRID
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Store configuration
// ---------------------------------------------------------------------------

// Singleton row (id = 1). All merchant branding lives here — never in code.
model StoreSettings {
  id              Int      @id @default(1)
  name            String
  logoUrl         String?
  faviconUrl      String?
  currency        String   @default("EGP")
  defaultLocale   String   @default("en")
  hotline         String?
  socialLinks     Json?
  seoDefaults     Json?
  navLinks        Json? // [{label,labelAr,href}] — header secondary links (§6.10 nav editor)
  footerLinks     Json? // [{label,labelAr,href}] — footer "useful links" column (§6.10)
  notificationPrefs Json? // {NEW_ORDER?:bool, LOW_STOCK?:bool, PENDING_REVIEW?:bool} (§6.14) — missing key = on
  maintenanceMode Boolean  @default(false)
  codEnabled      Boolean  @default(true)
  codFee          Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Users & addresses
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String?
  role         Role     @default(CUSTOMER)
  avatarUrl    String?
  isActive     Boolean  @default(true)
  adminNotes   String?  @db.Text // internal staff notes (§6.8) — never exposed to the customer
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlist      WishlistItem[]
  statusChanges OrderStatusLog[]
  auditLogs     AuditLog[]

  @@index([role])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String
  country   String
  city      String
  area      String?
  street    String
  building  String?
  phone     String
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String  @id @default(cuid())
  name      String
  nameAr    String
  slug      String  @unique
  iconSvg   String? @db.Text // pasted/uploaded SVG markup (§6.4)
  imageUrl  String?
  parentId  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id             String        @id @default(cuid())
  name           String
  nameAr         String
  slug           String        @unique
  description    String        @db.Text
  descriptionAr  String        @db.Text
  material       String?
  categoryId     String
  brand          String?
  basePrice      Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?      @db.Decimal(10, 2)
  cardPrice      Decimal?      @db.Decimal(10, 2)
  costPrice      Decimal?      @db.Decimal(10, 2)
  sku            String        @unique
  barcode        String?
  weight         Int? // grams
  tags           Json          @default("[]") // string[]
  status         ProductStatus @default(DRAFT)
  isFeatured     Boolean       @default(false)
  sortOrder      Int           @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category      Category            @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  variants      Variant[]
  reviews       Review[]
  orderItems    OrderItem[]
  wishlistedBy  WishlistItem[]
  inCollections CollectionProduct[]

  @@index([categoryId, status])
  @@index([status, isFeatured])
}

model ProductImage {
  id              String  @id @default(cuid())
  productId       String
  url             String
  alt             String
  sortOrder       Int     @default(0)
  variantColorRef String? // matches Variant.colorName to sync gallery on color pick

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Variant {
  id         String   @id @default(cuid())
  productId  String
  colorName  String
  colorHex   String
  size       String
  sku        String   @unique
  price      Decimal? @db.Decimal(10, 2) // overrides Product.basePrice when set
  stock      Int      @default(0)
  lowStockAt Int      @default(3)
  isActive   Boolean  @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, colorName, size])
  @@index([productId])
  @@index([stock])
}

model Collection {
  id       String  @id @default(cuid())
  name     String
  nameAr   String
  slug     String  @unique
  imageUrl String?
  isActive Boolean @default(true)

  products CollectionProduct[]
}

// Join model instead of productIds[] so admin drag-drop ordering persists.
model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String?
  guestEmail      String?
  guestPhone      String?
  subtotal        Decimal       @db.Decimal(10, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(10, 2)
  shippingTotal   Decimal       @default(0) @db.Decimal(10, 2)
  codFee          Decimal?      @db.Decimal(10, 2)
  grandTotal      Decimal       @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  status          OrderStatus   @default(PENDING)
  shippingAddress Json
  couponCode      String?
  promoBreakdown  Json? // itemized promo-engine result snapshot for admin detail
  trackingNumber  String?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusLog[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([paymentStatus])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String?
  variantId     String?
  nameSnapshot  String
  imageSnapshot String?
  price         Decimal @db.Decimal(10, 2)
  quantity      Int
  total         Decimal @db.Decimal(10, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusLog {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  byUserId   String?
  note       String?      @db.Text
  createdAt  DateTime     @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  byUser User? @relation(fields: [byUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Discounts & shipping
// ---------------------------------------------------------------------------

model Coupon {
  code         String      @id
  type         CouponType
  value        Decimal     @db.Decimal(10, 2)
  minSubtotal  Decimal?    @db.Decimal(10, 2)
  maxUses      Int?
  usedCount    Int         @default(0)
  perUserLimit Int?
  startsAt     DateTime
  endsAt       DateTime
  isActive     Boolean     @default(true)
  appliesTo    CouponScope @default(ALL)
  targetIds    Json        @default("[]") // string[]
}

model PromoRule {
  id       String    @id @default(cuid())
  name     String
  type     PromoType
  config   Json
  isActive Boolean   @default(true)
  priority Int       @default(0)
}

model ShippingZone {
  id        String   @id @default(cuid())
  name      String
  countries Json     @default("[]") // string[]
  cities    Json     @default("[]") // string[]
  rate      Decimal  @db.Decimal(10, 2)
  freeOver  Decimal? @db.Decimal(10, 2)
  etaText   String
  isActive  Boolean  @default(true)
}

// ---------------------------------------------------------------------------
// Content (CMS)
// ---------------------------------------------------------------------------

model Banner {
  id         String          @id @default(cuid())
  placement  BannerPlacement
  title      String?
  titleAr    String?
  subtitle   String?
  subtitleAr String?
  imageUrl   String?
  linkUrl    String?
  config     Json? // placement-specific extras (badge text, caption, style hints)
  sortOrder  Int             @default(0)
  isActive   Boolean         @default(true)

  @@index([placement, isActive])
}

model Page {
  id            String  @id @default(cuid())
  slug          String  @unique
  title         String
  titleAr       String
  contentRich   String  @db.Text
  contentRichAr String  @db.Text
  isActive      Boolean @default(true)
}

// ---------------------------------------------------------------------------
// Engagement & ops
// ---------------------------------------------------------------------------

model Review {
  id         String       @id @default(cuid())
  productId  String
  userId     String
  rating     Int // 1-5
  title      String?
  body       String?      @db.Text
  status     ReviewStatus @default(PENDING)
  adminReply String?      @db.Text
  createdAt  DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([status])
}

model NewsletterSub {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  type      String // open set (LOW_STOCK | NEW_ORDER | PENDING_REVIEW | ...) — intentionally not an enum
  title     String
  body      String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // e.g. product.update
  entity    String
  entityId  String
  diff      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}
